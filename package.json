{
  "name": "computer-file-governance",
  "version": "0.4.0",
  "private": false,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./lib/governance-validator.mjs",
    "./schemas/*": "./schemas/*"
  },
  "bin": {
