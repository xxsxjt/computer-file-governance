{
  "name": "computer-file-governance",
  "version": "0.4.0",
  "description": "Whole-machine file governance, shared information, and unified indexing framework for people and agents, with workspace/artifact and vault-backed adapter support.",
  "private": false,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./lib/governance-validator.mjs",
    "./executor": "./lib/governance-executor.mjs",
    "./secondary-index": "./lib/secondary-index.mjs",
    "./duplicate-clusters": "./lib/duplicate-clusters.mjs",
    "./incremental-refresh": "./lib/incremental-refresh.mjs",
    "./classification-suggestions": "./lib/classification-suggestions.mjs",
    "./user-report": "./lib/user-report.mjs",
    "./enterprise-controls": "./lib/enterprise-controls.mjs",
    "./credential-contract": "./lib/credential-contract.mjs",
    "./schemas/*": "./schemas/*"
  },
  "bin": {
    "cfg-validate": "./bin/cfg-validate.mjs",
    "cfg-find": "./bin/cfg-find.mjs",
    "cfg-duplicates": "./bin/cfg-duplicates.mjs",
    "cfg-suggest": "./bin/cfg-suggest.mjs",
    "cfg-tidy": "./bin/cfg-tidy.mjs"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODEOWNERS",
    "LICENSE",
    "adapters/",
    "bin/",
    "docs/",
    "lib/",
    "profiles/",
    "scenarios/",
    "schemas/"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:pack": "npm pack --dry-run",
    "bench:index": "node scripts/benchmark-secondary-index.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
