{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/computer-file-governance/transaction-manifest-v1.json",
  "title": "Computer File Governance Transaction Manifest",
  "$defs": {
    "localReference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)(?!.*[\\u0000-\\u001f\\u007f])(?!.*(?:%2[eE]){2})(?!.*(?:^|[:/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
      "description": "A machine-local reference or opaque identifier. Whitespace-only strings, control characters, URL-encoded parent segments, and literal parent-directory segments are rejected; this does not prove filesystem containment or resolve links/mounts."
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["transaction_id", "created_at", "status", "operation", "approval", "items", "verification", "rollback"],
  "properties": {
    "transaction_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["planned", "staged", "applied", "verified", "rolled_back", "outcome_unknown", "failed"] },
    "operation": { "enum": ["inventory", "copy", "move", "rename", "archive", "permission_change", "delete", "other"] },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "method", "approved_at"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "method": { "enum": ["explicit_user_request", "ui_confirmation", "rpc_confirmation", "policy_read_only", "not_required"] },
        "approved_at": { "type": "string", "format": "date-time" },
        "approver_ref": { "type": "string", "description": "Use a non-identifying local reference when identity is sensitive." }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_ref", "result"],
        "properties": {
          "source_ref": { "$ref": "#/$defs/localReference" },
          "destination_ref": { "$ref": "#/$defs/localReference" },
          "expected_bytes": { "type": "integer", "minimum": 0 },
          "source_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "result": { "enum": ["pending", "applied", "verified", "held", "rolled_back", "failed", "unknown"] },
          "result_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "note": { "type": "string" }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checked_at"],
      "properties": {
        "status": { "enum": ["not_run", "passed", "failed", "partial", "unknown"] },
        "checked_at": { "type": "string", "format": "date-time" },
        "checks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "instructions"],
      "properties": {
        "available": { "type": "boolean" },
        "instructions": { "type": "string" },
        "manifest_ref": { "$ref": "#/$defs/localReference" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": { "type": "string", "enum": ["copy", "move", "rename", "archive"] }
        },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "destination_ref": { "$ref": "#/$defs/localReference" }
              },
              "required": ["destination_ref"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "type": "string", "const": "planned" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "verification": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "const": "not_run" }
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "result": { "type": "string", "enum": ["pending", "held"] }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "type": "string", "const": "verified" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "verification": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "const": "passed" }
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "result": { "type": "string", "enum": ["verified", "held"] }
              }
            },
            "contains": {
              "type": "object",
              "properties": {
                "result": { "type": "string", "const": "verified" }
              },
              "required": ["result"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "type": "string", "const": "rolled_back" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "result": { "type": "string", "enum": ["rolled_back", "held", "pending"] }
              }
            },
            "contains": {
              "type": "object",
              "properties": {
                "result": { "type": "string", "const": "rolled_back" }
              },
              "required": ["result"]
            }
          }
        }
      }
    }
  ]
}
