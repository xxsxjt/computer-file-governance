{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/computer-file-governance/index-record-v1.json",
  "title": "Computer File Governance Index Record",
  "$defs": {
    "localReference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)(?!.*[\\u0000-\\u001f\\u007f])(?!.*(?:%2[eE]){2})(?!.*(?:^|[:/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
      "description": "A machine-local reference or opaque identifier. Whitespace-only strings, control characters, URL-encoded parent segments, and literal parent-directory segments are rejected; this does not prove filesystem containment or resolve links/mounts."
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "item_ref", "item_kind", "owner", "role", "privacy", "lifecycle", "confidence", "updated_at"],
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "item_ref": { "$ref": "#/$defs/localReference" },
    "item_kind": { "enum": ["file", "directory", "link", "mount", "logical_resource", "unknown"] },
    "owner": { "enum": ["personal", "system", "application", "project", "team", "external", "unknown"] },
    "role": { "enum": ["source", "active_work", "reference", "generated", "application_state", "cache", "archive", "inbox", "temporary", "backup", "unknown"] },
    "privacy": { "enum": ["public", "internal", "restricted", "secret", "unknown"] },
    "lifecycle": { "enum": ["active", "working", "reference", "archive", "rebuildable", "hold", "retired", "unknown"] },
    "purpose": { "type": "string" },
    "canonical_ref": { "$ref": "#/$defs/localReference", "description": "Local reference to the authoritative location for this role, if one exists." },
    "confidence": { "enum": ["high", "medium", "low"] },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "content_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "enum": ["sha256", "sha512"] },
        "digest": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "algorithm": { "const": "sha256" } }, "required": ["algorithm"] },
          "then": { "properties": { "digest": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" } } }
        },
        {
          "if": { "properties": { "algorithm": { "const": "sha512" } }, "required": ["algorithm"] },
          "then": { "properties": { "digest": { "type": "string", "pattern": "^[A-Fa-f0-9]{128}$" } } }
        }
      ]
    },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
